# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.turbo/
coverage/
*.tsbuildinfo

# env (solo se versiona .env.example)
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# certificados
*.pem
# docker/certs/: certificados CA locales (proxy corporativo, antivirus con inspección TLS)
# que los Dockerfile instalan si existen. Nunca se versionan; ver docker/certs/.gitkeep.
docker/certs/*
!docker/certs/.gitkeep

# Copia temporal de dist/ durante el empaquetado para Vercel (apps/api/scripts/bundle.mjs)
.dist-tsc/
