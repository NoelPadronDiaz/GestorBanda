{
  "name": "alcaravan-app",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de gestión integral para una banda de música (single tenant).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d postgres minio minio-init",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @alcaravan/api db:migrate",
    "db:deploy": "pnpm --filter @alcaravan/api db:deploy",
    "db:seed": "pnpm --filter @alcaravan/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "~5.9.3"
  }
}
