# Copia este fichero a `.env` (raíz del repo). Nunca subas `.env` a git.
# Sirve a docker-compose (interpolación) y a la API/seed cuando corren en el host con `pnpm dev`.
# Todas las variables de docker-compose tienen valor por defecto: sin .env también arranca.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=alcaravan
POSTGRES_PASSWORD=alcaravan_dev_password
POSTGRES_DB=alcaravan
POSTGRES_PORT=5432

# Solo para la API/Prisma ejecutándose en el HOST (dentro de compose se construye sola).
DATABASE_URL=postgresql://alcaravan:alcaravan_dev_password@localhost:5432/alcaravan?schema=public

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
# Mínimo 32 caracteres. En staging/producción: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=90
CORS_ORIGINS=http://localhost:5173
# true si la API está detrás de nginx/un balanceador (necesario para IP real y rate limiting).
TRUST_PROXY=false
# En producción la cookie del refresh token debe ser Secure (por defecto true si NODE_ENV=production).
# COOKIE_SECURE=true
# Swagger: activo salvo en producción. SWAGGER_ENABLED=true|false lo fuerza.
# SWAGGER_ENABLED=true

# ── Almacenamiento S3 (MinIO en local; cualquier proveedor S3 en producción) ─
S3_ENDPOINT=http://localhost:9000
# Host que ve el navegador en las URLs firmadas; si se omite se usa S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=alcaravan-documents
S3_ACCESS_KEY_ID=alcaravan
S3_SECRET_ACCESS_KEY=alcaravan_minio_password
S3_FORCE_PATH_STYLE=true
DOWNLOAD_URL_TTL_SECONDS=120
# Credenciales root de MinIO (solo compose); deben coincidir con S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=alcaravan
MINIO_ROOT_PASSWORD=alcaravan_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Web ─────────────────────────────────────────────────────────────────────
WEB_PORT=5173
# Con `pnpm dev` en el host, Vite reenvía /api a esta URL.
# VITE_API_PROXY_TARGET=http://localhost:3000

# ── Seed (primer administrador; el seed lo omite si faltan) ─────────────────
SEED_ADMIN_EMAIL=admin@alcaravan.local
# Mínimo 12 caracteres. Cámbiala tras el primer acceso.
SEED_ADMIN_PASSWORD=change-me-please-123
SEED_BAND_NAME=Mi banda
